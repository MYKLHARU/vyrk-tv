                <path android:name="rim" android:strokeColor="#FFD4A65A" android:strokeWidth="0.7" android:strokeAlpha="0"
                    android:strokeLineJoin="miter" android:pathData="M8,14 L30,14 L54,70 L50,88 Z M92,14 L70,14 L56,47 L63,63 Z" />
