        <group android:translateX="810" android:translateY="390" android:scaleX="3" android:scaleY="3">
            <group android:name="appear" android:pivotX="50" android:pivotY="50" android:scaleX="0.86" android:scaleY="0.86">
                <path android:name="mask" android:fillType="evenOdd" android:fillColor="#FF000000"
                    android:pathData="M-5000,-5000 L5100,-5000 L5100,5100 L-5000,5100 Z M8,14 L50,88 L54,70 L30,14 Z M92,14 L70,14 L56,47 L63,63 Z" />
                <path android:name="veil" android:fillColor="#FF000000" android:pathData="M8,14 L30,14 L54,70 L50,88 Z M92,14 L70,14 L56,47 L63,63 Z" />
                <path android:name="goldLeft" android:fillColor="#FFD4A65A" android:fillAlpha="0" android:pathData="M8,14 L30,14 L54,70 L50,88 Z" />
                <path android:name="goldRight" android:fillColor="#FFF3DEB0" android:fillAlpha="0" android:pathData="M92,14 L70,14 L56,47 L63,63 Z" />
                <path android:name="rune" android:fillColor="#FFB0843E" android:fillAlpha="0" android:pathData="M40,14 L60,14 L50,36 Z" />
                <group android:name="sheenClip">
                    <clip-path android:pathData="M8,14 L30,14 L54,70 L50,88 Z M92,14 L70,14 L56,47 L63,63 Z" />
                    <group android:name="sheen" android:translateX="-45">
