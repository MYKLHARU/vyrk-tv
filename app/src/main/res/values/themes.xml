<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window is the opening's own near-black, so the splash, the opening and the app
         follow on without a change of colour. -->
    <style name="Base.Theme.Vyrk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vyrk_launch</item>
        <item name="android:colorBackground">@color/vyrk_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Theme.Vyrk" parent="Base.Theme.Vyrk" />
    <style name="Theme.Vyrk.Player" parent="Theme.Vyrk">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <color name="vyrk_background">#FF0B141D</color>
    <color name="vyrk_launch">#FF050404</color>
</resources>
