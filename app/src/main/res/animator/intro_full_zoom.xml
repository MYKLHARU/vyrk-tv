<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="140" android:valueType="floatType"
        android:duration="1300" android:startOffset="1050" android:interpolator="@animator/intro_zoom_curve" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="140" android:valueType="floatType"
        android:duration="1300" android:startOffset="1050" android:interpolator="@animator/intro_zoom_curve" />
    <objectAnimator android:propertyName="translateX" android:valueFrom="0" android:valueTo="30" android:valueType="floatType"
        android:duration="1300" android:startOffset="1050" android:interpolator="@android:interpolator/decelerate_quad" />
    <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-15" android:valueType="floatType"
        android:duration="1300" android:startOffset="1050" android:interpolator="@android:interpolator/decelerate_quad" />
</set>
