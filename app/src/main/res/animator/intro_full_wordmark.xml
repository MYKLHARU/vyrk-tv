<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType"
        android:duration="650" android:startOffset="1500" android:interpolator="@android:interpolator/decelerate_cubic" />
    <objectAnimator android:duration="3750" android:interpolator="@android:interpolator/linear">
        <propertyValuesHolder android:propertyName="strokeAlpha" android:valueType="floatType">
            <keyframe android:fraction="0.0000" android:value="0" />
            <keyframe android:fraction="0.4000" android:value="0" />
            <keyframe android:fraction="0.4267" android:value="1" />
            <keyframe android:fraction="0.6400" android:value="1" />
            <keyframe android:fraction="0.7200" android:value="0" />
            <keyframe android:fraction="1.0000" android:value="0" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
